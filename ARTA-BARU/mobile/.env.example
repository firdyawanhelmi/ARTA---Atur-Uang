# Contoh variabel publik Expo (ter-commit, tanpa rahasia).
# Nilai EXPO_PUBLIC_* disertakan dalam bundle aplikasi — JANGAN taruh
# token, password, private key, atau rahasia di sini.
# Backend Laravel belum ditentukan (keputusan B4) — biarkan kosong.

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_ENV=development
